{
    "version": 3,
    "configurePresets": [
        {
            "name": "Release",
            "hidden": false,
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_EXPORT_COMPILE_COMMANDS": true,
                "GGML_CUDA": "ON"
            },
            "warnings": {
                "unusedCli": false
            }
        },
        {
            "name": "Debug",
            "hidden": false,
