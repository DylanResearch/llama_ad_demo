{
    "version": 3,
    "configurePresets": [
        {
            "name": "MSVC Debug",
            "binaryDir": "${sourceDir}/build/msvc/debug",
            "hidden": false,
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_EXPORT_COMPILE_COMMANDS": true,
                "GGML_CUDA": "ON",
                "OPENSSL_ROOT_DIR": "C:/Program Files/OpenSSL-Win64",
                "LLAMA_OPENSSL": "ON",
                "LIB_EAY_DEBUG": "C:/Program Files/OpenSSL-Win64/lib/VC/x64/MDd/libcrypto.lib",
                "LIB_EAY_RELEASE": "C:/Program Files/OpenSSL-Win64/lib/VC/x64/MD/libcrypto.lib",
                "SSL_EAY_DEBUG": "C:/Program Files/OpenSSL-Win64/lib/VC/x64/MDd/libssl.lib",
                "SSL_EAY_RELEASE": "C:/Program Files/OpenSSL-Win64/lib/VC/x64/MD/libssl.lib"
            }
        },
        {
            "name": "MSVC Release",
            "binaryDir": "${sourceDir}/build/msvc/release",
            "hidden": false,
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_EXPORT_COMPILE_COMMANDS": true,
                "GGML_CUDA": "ON"
            }
        },
        {
            "name": "clangd Debug",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/clangd/debug",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_EXPORT_COMPILE_COMMANDS": true,
                "GGML_CUDA": "ON",
                "CMAKE_C_COMPILER": "gcc",
                "CMAKE_CXX_COMPILER": "g++"
            }
        },
        {
            "name": "clangd Release",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/clangd/release",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_EXPORT_COMPILE_COMMANDS": true,
                "GGML_CUDA": "ON",
                "CMAKE_C_COMPILER": "gcc",
                "CMAKE_CXX_COMPILER": "g++"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "release",
            "displayName": "Release Build",
            "configurePreset": "clangd Release",
            "configuration": "Release"
        },
        {
            "name": "debug",
            "displayName": "Debug Build",
            "configurePreset": "clangd Debug",
            "configuration": "Debug"
        }
    ]
}